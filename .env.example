# Required for secure production sessions
SECRET_KEY=replace-with-a-long-random-secret

# Google OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/auth/callback

# NVIDIA NIM / build.nvidia.com API key
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Comma-separated email addresses granted administrator access
ADMIN_EMAILS=your-admin-email@example.com

# Optional durable PostgreSQL URL. SQLite is used when omitted, but Render Free
# has ephemeral storage; SQLite data is not durable across restarts/deploys.
DATABASE_URL=

# Stripe Checkout: keep test mode enabled until the full flow is verified
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_PAYMENTS_ENABLED=false
# Comma-separated verified Google email addresses that can download PDFs free
STRIPE_TESTER_EMAILS=qa-tester@example.com
# Deployed HTTPS origin, e.g. https://lumidesk-ai.onrender.com
PUBLIC_BASE_URL=http://127.0.0.1:8000

APP_ENV=production
MAX_UPLOAD_MB=30
DAILY_TUTOR_LIMIT=0
DAILY_REPORT_LIMIT=0
